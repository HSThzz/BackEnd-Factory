{
  "name": "create-backend-api",
  "version": "0.2.0",
  "description": "A CLI tool to generate lean Node.js backend scaffolds with TypeScript, Express/Fastify, and TypeORM/Prisma",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "create-backend-api": "dist/bin/create-backend-api.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "dev:cli": "tsx bin/create-backend-api.ts",
    "lint": "eslint src bin",
    "format": "prettier --write \"src/**/*.ts\" \"bin/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"bin/**/*.ts\"",
    "test": "jest"
  },
  "keywords": [
    "cli",
    "backend",
    "generator",
    "typescript",
    "express",
    "fastify",
    "typeorm",
    "prisma"
  ],
  "author": "Thiago Esmerio Fernandes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HSThzz/create-backend-api.git"
  },
  "bugs": {
    "url": "https://github.com/HSThzz/create-backend-api/issues"
  },
  "homepage": "https://github.com/HSThzz/create-backend-api#readme",
  "files": [
    "dist",
    "src/templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.5",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.0",
    "handlebars": "^4.7.9",
    "inquirer": "^14.0.2",
    "ora": "^9.4.1"
  }
}
