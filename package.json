{
  "name": "create-backend-api",
  "version": "0.1.0",
  "description": "A CLI tool to generate Node.js backend projects with TypeScript, Express/Fastify, and TypeORM/Prisma",
  "main": "dist/index.js",
  "bin": {
    "create-backend-api": "dist/bin/create-backend-api.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "dev:cli": "ts-node bin/create-backend-api.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "keywords": [
    "cli",
    "backend",
    "generator",
    "typescript",
    "express",
    "fastify",
    "typeorm",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.4.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^10.0.3",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "fs-extra": "^11.3.4",
    "handlebars": "^4.7.8",
    "inquirer": "^13.3.0",
    "ora": "^9.3.0"
  }
}
